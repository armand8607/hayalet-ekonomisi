; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hayalet Ekonomisi"
config/description="Marksist deger teorisini simule eden cok ulkeli makroekonomi oyunu. Motor: v4.4-Frozen."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

; SIRA YUK TASIR: her otoload yalnizca kendisinden ONCEKILERE bagimlidir.
;   Params : donmus kalibrasyon sabitleri (344 alan). Hicbir seye bagli degil.
;   Tables : ERAS / KURUMLAR / PLAN_PROFILLERI / dunya tohum tablosu. Params'i okur.
;   Save   : user:// erisen TEK yer.
;   Sim    : aktif GhostEngine ornegini tutar, arayuze sinyal yayar.
; Motorun kendisi otoload DEGILDIR (RefCounted sinif): Monte Carlo ve parite
; kosulari ayni anda birden cok bagimsiz ornek gerektiriyor.
Params="*res://scripts/params.gd"
Tables="*res://scripts/tables.gd"
Save="*res://scripts/save_service.gd"
Sim="*res://scripts/sim.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Android disa aktarimi ETC2/ASTC ister; oyunda hic doku olmasa bile bu satir
; olmadan export "configuration error" ile durur.
textures/vram_compression/import_etc2_astc=true
